# APP CONFIG (DO NOT REMOVE!)
APP_NAME="VoxPilot POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.voxpilothq.io

IGNITER_CARTE_KEY=
IGNITER_LOCATION_MODE=single

# DATABASE CONFIG (DO NOT REMOVE!)
DB_CONNECTION=mysql
DB_HOST=pos-db
DB_PORT=3306
DB_DATABASE=voxpilot_pos
DB_USERNAME=voxpilot_pos
DB_PASSWORD=
DB_PREFIX=ti_

# CACHE & SESSION
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=pos-redis
REDIS_PORT=6379

# QUEUE (queued broadcasts + VoxPilot status callbacks; run by the queue-worker supervisor program)
QUEUE_CONNECTION=database

# BROADCAST / REVERB
# Shared credentials (generate unique values for production)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Server-side: where the Reverb process binds, and where the Laravel broadcaster reaches it
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_SERVER_SCHEME=http
REVERB_CLIENT_HOST=127.0.0.1

# Client-side: browser Echo connects through reverse proxy
REVERB_HOST=pos.voxpilothq.io
REVERB_PORT=443
REVERB_SCHEME=https

# VOXPILOT PROVISIONING
# Shared secret between VoxPilot Force and POS for tenant provisioning.
# Must be at least 32 characters. Generate: php -r "echo bin2hex(random_bytes(32));"
VOXPILOT_PROVISIONING_SECRET=

# VOXPILOT HMAC
# Shared secret used to verify signed inbound requests and to sign order status callbacks
# sent to the integrator (POS_HMAC_SECRET on VoxPilot Force). Must be at least 32 characters.
VOXPILOT_HMAC_SECRET=

# MAIL
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@voxpilothq.io
MAIL_FROM_NAME="${APP_NAME}"
